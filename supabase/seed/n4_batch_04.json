{"level":"N4","batch":4,"vocabulary":[{"word":"運転","reading":"うんてん","meaning":"driving"},{"word":"運動","reading":"うんどう","meaning":"exercise"},{"word":"生活","reading":"せいかつ","meaning":"daily life"},{"word":"習慣","reading":"しゅうかん","meaning":"habit"},{"word":"文化","reading":"ぶんか","meaning":"culture"},{"word":"社会","reading":"しゃかい","meaning":"society"},{"word":"世界","reading":"せかい","meaning":"world"},{"word":"自然","reading":"しぜん","meaning":"nature"},{"word":"旅行","reading":"りょこう","meaning":"travel"},{"word":"景色","reading":"けしき","meaning":"scenery"}],"grammar":[{"pattern":"〜ようになる","meaning":"come to be able to; become","example":"日本語が話せるようになりました。"},{"pattern":"〜ようにする","meaning":"make an effort to","example":"毎日漢字を読むようにしています。"},{"pattern":"〜ておく","meaning":"do in advance","example":"旅行の前にホテルを予約しておきます。"},{"pattern":"〜てしまう","meaning":"finish; unfortunately do","example":"宿題を忘れてしまいました。"},{"pattern":"〜てもいい","meaning":"may; be allowed to","example":"ここで写真を撮ってもいいです。"}],"kanji":[{"kanji":"運","meaning":"carry; luck"},{"kanji":"動","meaning":"move"},{"kanji":"生","meaning":"life; live"},{"kanji":"習","meaning":"learn; habit"},{"kanji":"文","meaning":"writing; culture"},{"kanji":"化","meaning":"change"},{"kanji":"社","meaning":"company; society"},{"kanji":"会","meaning":"meet"},{"kanji":"世","meaning":"world; generation"},{"kanji":"界","meaning":"world; boundary"}],"quiz":[{"question":"毎日漢字を読むようにしています。何を表しますか？","answer":"an effort or habit to do something"},{"question":"予約しておきます。の意味は？","answer":"I will reserve it in advance."}]}