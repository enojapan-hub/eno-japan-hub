  "grammar":[
    {"pattern":"〜から","function":"menyatakan alasan","example":"雨ですから、行きません。","translation":"Karena hujan, saya tidak pergi."},{"pattern":"〜まで","function":"menyatakan batas waktu/tempat","example":"五時まで働きます。","translation":"Saya bekerja sampai jam lima."},{"pattern":"〜ぐらい／くらい","function":"menyatakan perkiraan jumlah","example":"十分ぐらい待ってください。","translation":"Tolong tunggu sekitar sepuluh menit."},{"pattern":"〜だけ","function":"menyatakan pembatasan","example":"水だけ飲みます。","translation":"Saya hanya minum air."},{"pattern":"〜しか〜ない","function":"menyatakan hanya; selalu dengan bentuk negatif","example":"千円しかありません。","translation":"Saya hanya punya 1.000 yen."},{"pattern":"〜ことができます","function":"menyatakan kemampuan","example":"日本語を話すことができます。","translation":"Saya bisa berbicara bahasa Jepang."},{"pattern":"〜ことが好きです","function":"menyatakan kesukaan terhadap aktivitas","example":"本を読むことが好きです。","translation":"Saya suka membaca buku."},{"pattern":"〜たいです","function":"menyatakan keinginan melakukan sesuatu","example":"日本へ行きたいです。","translation":"Saya ingin pergi ke Jepang."},{"pattern":"〜ましょうか","function":"menawarkan bantuan atau tindakan","example":"荷物を持ちましょうか。","translation":"Biar saya bawakan barangnya?"},{"pattern":"〜ませんか","function":"mengajak dengan sopan","example":"一緒に昼ご飯を食べませんか。","translation":"Maukah makan siang bersama?"},{"pattern":"〜てもいいです","function":"meminta/memberi izin","example":"ここに座ってもいいですか。","translation":"Bolehkah saya duduk di sini?"},{"pattern":"〜てはいけません","function":"melarang","example":"ここで写真を撮ってはいけません。","translation":"Tidak boleh mengambil foto di sini."},{"pattern":"〜てください","function":"meminta tindakan","example":"名前を書いてください。","translation":"Tolong tulis nama."},{"pattern":"〜ています","function":"menyatakan tindakan sedang berlangsung","example":"今、勉強しています。","translation":"Sekarang saya sedang belajar."},{"pattern":"〜ています","function":"menyatakan keadaan hasil","example":"窓が開いています。","translation":"Jendelanya dalam keadaan terbuka."},{"pattern":"〜たことがあります","function":"menyatakan pengalaman","example":"日本へ行ったことがあります。","translation":"Saya pernah pergi ke Jepang."},{"pattern":"〜たり〜たりします","function":"menyebut beberapa aktivitas sebagai contoh","example":"日曜日は映画を見たり、買い物したりします。","translation":"Hari Minggu saya menonton film, berbelanja, dan sebagainya."},{"pattern":"〜と思います","function":"menyatakan pendapat sederhana","example":"明日は雨だと思います。","translation":"Saya pikir besok hujan."},{"pattern":"〜から〜まで","function":"menyatakan rentang waktu/tempat","example":"九時から五時まで働きます。","translation":"Saya bekerja dari jam sembilan sampai jam lima."},{"pattern":"もう〜ました","function":"menyatakan sesuatu sudah dilakukan","example":"もう昼ご飯を食べました。","translation":"Saya sudah makan siang."}
