  "grammar":[
    {"pattern":"N は どうですか","function":"menanyakan pendapat atau keadaan","example":"日本の生活はどうですか。","translation":"Bagaimana kehidupan di Jepang?"},
    {"pattern":"N は どんな N ですか","function":"menanyakan jenis atau sifat","example":"どんな町ですか。","translation":"Kota seperti apa?"},
    {"pattern":"N が あります／います","function":"menyatakan keberadaan benda/orang","example":"教室に先生がいます。","translation":"Ada guru di kelas."},
    {"pattern":"N は Place に あります／います","function":"menyatakan lokasi keberadaan","example":"銀行は駅の前にあります。","translation":"Bank ada di depan stasiun."},
    {"pattern":"N の N","function":"hubungan kepemilikan atau keterangan","example":"日本語の先生です。","translation":"Guru bahasa Jepang."},
    {"pattern":"N と N","function":"menghubungkan dua kata benda","example":"父と母です。","translation":"Ayah dan ibu."},
    {"pattern":"N や N","function":"menyebut beberapa contoh benda","example":"本や雑誌があります。","translation":"Ada buku, majalah, dan sebagainya."},
    {"pattern":"N から N まで","function":"menyatakan rentang dari sampai","example":"九時から五時まで働きます。","translation":"Bekerja dari jam sembilan sampai jam lima."},
    {"pattern":"Time に V","function":"menyatakan waktu melakukan tindakan","example":"七時に起きます。","translation":"Bangun pukul tujuh."},
    {"pattern":"Place で V","function":"menyatakan tempat berlangsungnya tindakan","example":"学校で勉強します。","translation":"Belajar di sekolah."},
    {"pattern":"N と V","function":"menyatakan melakukan tindakan bersama","example":"友達と映画を見ます。","translation":"Menonton film bersama teman."},
    {"pattern":"V ませんか","function":"mengajak dengan sopan","example":"一緒に昼ご飯を食べませんか。","translation":"Mau makan siang bersama?"},
    {"pattern":"V ましょう","function":"mengajak atau menyatakan keputusan bersama","example":"行きましょう。","translation":"Ayo pergi."},
    {"pattern":"V たいです","function":"menyatakan keinginan melakukan tindakan","example":"日本へ行きたいです。","translation":"Saya ingin pergi ke Jepang."},
    {"pattern":"N が ほしいです","function":"menyatakan keinginan memiliki benda","example":"新しいかばんがほしいです。","translation":"Saya ingin tas baru."},
    {"pattern":"N が 好きです／嫌いです","function":"menyatakan suka atau tidak suka","example":"日本料理が好きです。","translation":"Saya suka masakan Jepang."},
    {"pattern":"N が 上手です／下手です","function":"menyatakan kemampuan atau kemahiran","example":"日本語が上手です。","translation":"Pandai bahasa Jepang."},
    {"pattern":"N は N より Adj です","function":"membandingkan dua benda/orang","example":"東京は大阪より大きいです。","translation":"Tokyo lebih besar daripada Osaka."},
    {"pattern":"N のほうが Adj です","function":"menyatakan pihak yang lebih dalam perbandingan","example":"電車のほうが速いです。","translation":"Kereta lebih cepat."},
    {"pattern":"どちらが Adj ですか","function":"menanyakan pilihan dalam perbandingan","example":"コーヒーとお茶と、どちらが好きですか。","translation":"Mana yang lebih disukai, kopi atau teh?"}
