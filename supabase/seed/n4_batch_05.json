{"level":"N4","batch":5,"vocabulary":[{"word":"必要","reading":"ひつよう","meaning":"necessary"},{"word":"十分","reading":"じゅうぶん","meaning":"enough"},{"word":"安心","reading":"あんしん","meaning":"relief; peace of mind"},{"word":"心配","reading":"しんぱい","meaning":"worry"},{"word":"残念","reading":"ざんねん","meaning":"regrettable"},{"word":"親切","reading":"しんせつ","meaning":"kind"},{"word":"丁寧","reading":"ていねい","meaning":"polite; careful"},{"word":"大切","reading":"たいせつ","meaning":"important"},{"word":"上手","reading":"じょうず","meaning":"skillful"},{"word":"苦手","reading":"にがて","meaning":"poor at; weak point"}],"grammar":[{"pattern":"〜すぎる","meaning":"too much; excessively","example":"食べすぎました。"},{"pattern":"〜やすい","meaning":"easy to do","example":"この本は読みやすいです。"},{"pattern":"〜にくい","meaning":"difficult to do","example":"この漢字は覚えにくいです。"},{"pattern":"〜始める","meaning":"begin doing","example":"雨が降り始めました。"},{"pattern":"〜終わる","meaning":"finish doing","example":"宿題を書き終わりました。"}],"kanji":[{"kanji":"必","meaning":"certainly"},{"kanji":"十","meaning":"ten"},{"kanji":"分","meaning":"part; minute"},{"kanji":"心","meaning":"heart; mind"},{"kanji":"配","meaning":"distribute; worry"},{"kanji":"残","meaning":"remain"},{"kanji":"念","meaning":"thought; concern"},{"kanji":"親","meaning":"parent; intimate"},{"kanji":"切","meaning":"cut; important"},{"kanji":"苦","meaning":"suffer; difficult"}],"quiz":[{"question":"読みやすい本 means what?","answer":"a book that is easy to read"},{"question":"食べすぎました。means what?","answer":"I ate too much."}]}