  "grammar": [
    {"pattern":"～てください","function":"permintaan sopan","example":"ここに名前を書いてください。","meaning_id":"Tolong tulis nama di sini."},
    {"pattern":"～てもいいです","function":"meminta/memberi izin","example":"ここに座ってもいいです。","meaning_id":"Boleh duduk di sini."},
    {"pattern":"～てはいけません","function":"larangan","example":"ここで写真を撮ってはいけません。","meaning_id":"Tidak boleh mengambil foto di sini."},
    {"pattern":"～ています","function":"sedang melakukan/keadaan berlanjut","example":"今、本を読んでいます。","meaning_id":"Sekarang sedang membaca buku."},
    {"pattern":"～たいです","function":"keinginan melakukan","example":"日本へ行きたいです。","meaning_id":"Saya ingin pergi ke Jepang."},
    {"pattern":"～ましょう","function":"ajakan","example":"一緒に食べましょう。","meaning_id":"Mari makan bersama."},
    {"pattern":"～ませんか","function":"ajakan halus","example":"一緒に映画を見ませんか。","meaning_id":"Mau menonton film bersama?"},
    {"pattern":"～から","function":"alasan","example":"暑いですから、窓を開けます。","meaning_id":"Karena panas, saya membuka jendela."},
    {"pattern":"～が好きです","function":"menyatakan kesukaan","example":"私は音楽が好きです。","meaning_id":"Saya suka musik."},
    {"pattern":"～が上手です","function":"menyatakan kemampuan","example":"田中さんは歌が上手です。","meaning_id":"Tanaka pandai bernyanyi."},
    {"pattern":"～が下手です","function":"menyatakan kurang mahir","example":"私は料理が下手です。","meaning_id":"Saya kurang pandai memasak."},
    {"pattern":"～があります","function":"menyatakan keberadaan benda","example":"部屋に机があります。","meaning_id":"Ada meja di kamar."},
    {"pattern":"～がいます","function":"menyatakan keberadaan makhluk hidup","example":"公園に子どもがいます。","meaning_id":"Ada anak-anak di taman."},
    {"pattern":"～の前に","function":"menyatakan lokasi relatif","example":"駅の前に店があります。","meaning_id":"Ada toko di depan stasiun."},
    {"pattern":"～の後ろに","function":"menyatakan lokasi relatif","example":"学校の後ろに公園があります。","meaning_id":"Ada taman di belakang sekolah."},
    {"pattern":"～の中に","function":"menyatakan lokasi di dalam","example":"かばんの中に本があります。","meaning_id":"Ada buku di dalam tas."},
    {"pattern":"～と～","function":"menghubungkan kata benda","example":"パンと牛乳を買います。","meaning_id":"Membeli roti dan susu."},
    {"pattern":"～をください","function":"meminta barang","example":"水を二つください。","meaning_id":"Tolong beri saya dua air/minuman."},
    {"pattern":"～から～まで","function":"rentang waktu/tempat","example":"九時から五時まで働きます。","meaning_id":"Bekerja dari jam sembilan sampai lima."},
    {"pattern":"～ぐらい","function":"perkiraan jumlah/waktu","example":"十分ぐらい待ってください。","meaning_id":"Tolong tunggu sekitar sepuluh menit."}
