  "grammar": [
    {"pattern":"～から","function":"menyatakan alasan","example":"雨ですから、行きません。","translation":"Karena hujan, saya tidak pergi."},
    {"pattern":"～まで","function":"batas waktu/tempat","example":"五時まで働きます。","translation":"Saya bekerja sampai pukul lima."},
    {"pattern":"～といっしょに","function":"melakukan sesuatu bersama","example":"友達といっしょに行きます。","translation":"Saya pergi bersama teman."},
    {"pattern":"～が好きです","function":"menyatakan kesukaan","example":"日本語が好きです。","translation":"Saya suka bahasa Jepang."},
    {"pattern":"～が上手です","function":"menyatakan kemampuan yang baik","example":"田中さんは料理が上手です。","translation":"Tanaka pandai memasak."},
    {"pattern":"～がわかります","function":"menyatakan pemahaman","example":"日本語が少しわかります。","translation":"Saya sedikit mengerti bahasa Jepang."},
    {"pattern":"～があります／います","function":"menyatakan keberadaan","example":"机の上に本があります。","translation":"Ada buku di atas meja."},
    {"pattern":"～てもいいです","function":"meminta/memberi izin","example":"ここに座ってもいいですか。","translation":"Bolehkah saya duduk di sini?"},
    {"pattern":"～てはいけません","function":"melarang","example":"ここで写真を撮ってはいけません。","translation":"Tidak boleh mengambil foto di sini."},
    {"pattern":"～ましょうか","function":"menawarkan bantuan","example":"荷物を持ちましょうか。","translation":"Biar saya bawakan barangnya?"},
    {"pattern":"～ませんか","function":"mengajak secara sopan","example":"いっしょに昼ご飯を食べませんか。","translation":"Mau makan siang bersama?"},
    {"pattern":"～たいです","function":"menyatakan keinginan melakukan","example":"日本へ行きたいです。","translation":"Saya ingin pergi ke Jepang."},
    {"pattern":"～ています","function":"menyatakan sedang melakukan/keadaan","example":"今、本を読んでいます。","translation":"Sekarang saya sedang membaca buku."},
    {"pattern":"～てから","function":"menyatakan urutan setelah melakukan","example":"ご飯を食べてから、勉強します。","translation":"Setelah makan, saya belajar."},
    {"pattern":"～ことがあります","function":"menyatakan pernah melakukan","example":"日本へ行ったことがあります。","translation":"Saya pernah pergi ke Jepang."},
    {"pattern":"～たり～たりします","function":"menyebut beberapa aktivitas sebagai contoh","example":"日曜日は本を読んだり、映画を見たりします。","translation":"Hari Minggu saya melakukan hal seperti membaca buku dan menonton film."},
    {"pattern":"～ほうがいいです","function":"memberi saran sederhana","example":"早く寝たほうがいいです。","translation":"Sebaiknya tidur lebih awal."},
    {"pattern":"～まえに","function":"menyatakan sebelum","example":"寝る前に歯をみがきます。","translation":"Saya menyikat gigi sebelum tidur."},
    {"pattern":"～あとで","function":"menyatakan setelah","example":"仕事のあとで、買い物をします。","translation":"Setelah bekerja, saya berbelanja."},
    {"pattern":"～とき","function":"menyatakan ketika/saat","example":"暇なとき、本を読みます。","translation":"Saat senggang, saya membaca buku."}
