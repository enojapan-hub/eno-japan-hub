  "grammar":[
    {"pattern":"V-ています","function":"menyatakan tindakan yang sedang berlangsung atau keadaan hasil","example":"今、本を読んでいます。","translation":"Sekarang saya sedang membaca buku."},
    {"pattern":"V-てもいいです","function":"meminta/memberi izin","example":"ここに座ってもいいですか。","translation":"Bolehkah saya duduk di sini?"},
    {"pattern":"V-てはいけません","function":"menyatakan larangan","example":"ここで写真を撮ってはいけません。","translation":"Tidak boleh mengambil foto di sini."},
    {"pattern":"V-てください","function":"permintaan sopan","example":"もう一度言ってください。","translation":"Tolong katakan sekali lagi."},
    {"pattern":"V-ないでください","function":"meminta agar seseorang tidak melakukan sesuatu","example":"ここで話さないでください。","translation":"Tolong jangan berbicara di sini."},
    {"pattern":"V-ましょう","function":"ajakan","example":"一緒に行きましょう。","translation":"Mari pergi bersama."},
    {"pattern":"V-ませんか","function":"mengajak dengan sopan","example":"一緒に昼ご飯を食べませんか。","translation":"Mau makan siang bersama?"},
    {"pattern":"Nがあります","function":"menyatakan keberadaan benda","example":"机の上に本があります。","translation":"Ada buku di atas meja."},
    {"pattern":"Nがいます","function":"menyatakan keberadaan makhluk hidup","example":"教室に先生がいます。","translation":"Ada guru di kelas."},
    {"pattern":"Nの前に","function":"menyatakan lokasi relatif","example":"駅の前に銀行があります。","translation":"Ada bank di depan stasiun."},
    {"pattern":"Nの後ろに","function":"menyatakan lokasi relatif","example":"学校の後ろに公園があります。","translation":"Ada taman di belakang sekolah."},
    {"pattern":"NからNまで","function":"menyatakan rentang dari dan sampai","example":"九時から五時まで働きます。","translation":"Saya bekerja dari jam sembilan sampai jam lima."},
    {"pattern":"NよりNのほうが","function":"membandingkan dua hal","example":"電車よりバスのほうが安いです。","translation":"Bus lebih murah daripada kereta."},
    {"pattern":"Nが好きです","function":"menyatakan kesukaan","example":"日本語が好きです。","translation":"Saya suka bahasa Jepang."},
    {"pattern":"Nが分かります","function":"menyatakan pemahaman","example":"日本語が少し分かります。","translation":"Saya sedikit mengerti bahasa Jepang."},
    {"pattern":"Nが上手です","function":"menyatakan kemampuan","example":"彼は料理が上手です。","translation":"Dia pandai memasak."},
    {"pattern":"V-ることができます","function":"menyatakan kemampuan melakukan sesuatu","example":"漢字を読むことができます。","translation":"Saya bisa membaca kanji."},
    {"pattern":"V-る前に","function":"menyatakan tindakan sebelum tindakan lain","example":"寝る前に歯を磨きます。","translation":"Saya menyikat gigi sebelum tidur."},
    {"pattern":"V-た後で","function":"menyatakan tindakan setelah tindakan lain","example":"ご飯を食べた後で勉強します。","translation":"Saya belajar setelah makan."},
    {"pattern":"NとN","function":"menghubungkan dua nomina","example":"先生と学生","translation":"guru dan siswa"}
  ],
