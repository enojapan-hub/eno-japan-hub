{"level":"N4","batch":3,"vocabulary":[{"word":"自由","reading":"じゆう","meaning":"freedom; free"},{"word":"安全","reading":"あんぜん","meaning":"safe; safety"},{"word":"危険","reading":"きけん","meaning":"dangerous; danger"},{"word":"最近","reading":"さいきん","meaning":"recently"},{"word":"特別","reading":"とくべつ","meaning":"special"},{"word":"普通","reading":"ふつう","meaning":"ordinary; normal"},{"word":"簡単","reading":"かんたん","meaning":"easy; simple"},{"word":"複雑","reading":"ふくざつ","meaning":"complicated"},{"word":"便利","reading":"べんり","meaning":"convenient"},{"word":"不便","reading":"ふべん","meaning":"inconvenient"}],"grammar":[{"pattern":"〜し","meaning":"and; giving reasons","example":"この店は安いし、おいしいです。"},{"pattern":"〜ので","meaning":"because; since","example":"雨なので、出かけません。"},{"pattern":"〜のに","meaning":"although; despite","example":"勉強したのに、忘れました。"},{"pattern":"〜ために","meaning":"for the purpose of","example":"日本へ行くために、日本語を勉強しています。"},{"pattern":"〜ことがある","meaning":"have experienced doing","example":"富士山に登ったことがあります。"}],"kanji":[{"kanji":"自","meaning":"self"},{"kanji":"由","meaning":"reason"},{"kanji":"安","meaning":"cheap; safe"},{"kanji":"危","meaning":"dangerous"},{"kanji":"険","meaning":"danger"},{"kanji":"最","meaning":"most; latest"},{"kanji":"近","meaning":"near; recent"},{"kanji":"特","meaning":"special"},{"kanji":"普","meaning":"ordinary"},{"kanji":"便","meaning":"convenient"}],"quiz":[{"question":"「便利」の反対に近い言葉は？","answer":"不便"},{"question":"富士山に登ったことがあります。は何を表しますか？","answer":"past experience"}]}